# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firebase Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id

# Telegram Bot
VITE_TELEGRAM_BOT_TOKEN=your-bot-token
VITE_TELEGRAM_MINI_APP_URL=https://t.me/your_bot/app

# API
VITE_API_BASE_URL=https://your-api.com

# Crypto Payment Addresses
VITE_PAYMENT_BTC_ADDRESS=your-btc-address
VITE_PAYMENT_ETH_ADDRESS=your-eth-address
VITE_PAYMENT_USDT_TRC20_ADDRESS=your-trc20-address
VITE_PAYMENT_USDT_ERC20_ADDRESS=your-erc20-address
VITE_PAYMENT_USDT_BEP20_ADDRESS=your-bep20-address

# Blockchain API Keys
VITE_ETHERSCAN_API_KEY=your-etherscan-key
VITE_BSCSCAN_API_KEY=your-bscscan-key

# External APIs
VITE_COINGECKO_API_KEY=your-coingecko-key
VITE_BINANCE_API_KEY=your-binance-key

# Environment
VITE_APP_ENV=production
NODE_ENV=production